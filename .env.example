# PostgreSQL
POSTGRES_DB=fleetcontrol
POSTGRES_USER=fleetcontrol
POSTGRES_PASSWORD=change_me_local_password
POSTGRES_PORT=5432

# Aplicacao backend
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/fleetcontrol
SPRING_DATASOURCE_USERNAME=fleetcontrol
SPRING_DATASOURCE_PASSWORD=change_me_local_password
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET=replace_with_a_strong_secret_with_at_least_32_bytes
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Aplicacao frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api
